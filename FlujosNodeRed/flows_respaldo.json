        "head": "",
        "format": "<template>\n    <!-- Esta caja roja se muestra solo si llega un mensaje de alerta -->\n    <div class=\"alerta-roja\" v-if=\"msg?.payload\">\n        <h3>⚠️ ALERTA: PIEZA NO ENCONTRADA</h3>\n        <p>{{ msg.payload }}</p>\n    </div>\n    \n    <!-- Esta caja verde se muestra por defecto cuando no hay errores -->\n    <div class=\"alerta-verde\" v-else>\n        <h3>✅ SISTEMA ACTIVO</h3>\n        <p>Operando normalmente. El robot está a la espera.</p>\n    </div>\n</template>\n\n<style>\n    /* Diseño y colores de las cajas */\n    .alerta-roja {\n        background-color: #8b0000; \n        color: white; \n        padding: 15px; \n        border-radius: 5px; \n        border-left: 8px solid red;\n    }\n    .alerta-verde {\n        background-color: #242424;\n        color: #4CAF50;\n        padding: 15px;\n        border-radius: 5px;\n        border-left: 8px solid #4CAF50;\n    }\n    h3 {\n        margin-top: 0;\n        margin-bottom: 5px;\n    }\n    p {\n        margin: 0;\n        font-size: 16px;\n    }\n</style>",
