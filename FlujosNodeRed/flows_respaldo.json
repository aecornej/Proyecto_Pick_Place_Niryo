        "format": "<template>\n    <div\n        style=\"display: flex; justify-content: center; background-color: #000; border-radius: 8px; overflow: hidden; padding: 10px;\">\n        <!-- Aquí irá el video de tu cámara. Cuando la programemos, cambiaremos la IP -->\n        <img src=\"http://IP_DE_UBUNTU:5000/video_feed\" width=\"100%\" alt=\"Esperando conexión de cámara...\" style=\"max-height: 400px; object-fit: contain;\">\n    </div>\n</template>",
