    {
        "id": "7a6ff6cc3fcfa8d5",
        "type": "function",
        "z": "016ea9c222f709f1",
        "name": "function 1",
        "func": "// 1. Verificamos si el mensaje llegó como texto y lo convertimos a objeto JSON\nlet datos = msg.payload;\nif (typeof datos === \"string\") {\n    try {\n        datos = JSON.parse(datos);\n    } catch(e) {\n        msg.payload = \"Error: El dato no es un JSON válido\";\n        return msg;\n    }\n}\n\n// 2. Extraemos las coordenadas y armamos un texto fácil de leer\nlet texto = `X: ${datos.x} | Y: ${datos.y} | Z: ${datos.z} || Roll: ${datos.roll}° | Pitch: ${datos.pitch}° | Yaw: ${datos.yaw}°`;\n\n// 3. Reemplazamos el mensaje original con nuestro nuevo texto formateado\nmsg.payload = texto;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 180,
        "wires": [
            [
                "80e2d82346730997"
            ]
        ]
    },
