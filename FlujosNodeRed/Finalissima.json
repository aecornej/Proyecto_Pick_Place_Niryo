    {
        "id": "8a99308e8be59cc7",
        "type": "function",
        "z": "74d43a4238c77af7",
        "name": "function 1",
        "func": "// 1. Python envía un texto con comas (ej. \"150.5,200.1,5.0,45.2\")\n// split(\",\") lo divide y lo convierte en una lista de 4 datos.\nlet datos = msg.payload.split(\",\");\n\nif (datos.length === 4) {\n    // 2. Preparamos un mensaje individual para cada cable de salida\n    let msgTextoCompleto = { payload: msg.payload }; // Salida 1: Para \"Coordenadas Objetivo\"\n    let msgX = { payload: datos[0] };                // Salida 2: Para X\n    let msgY = { payload: datos[1] };                // Salida 3: Para Y\n    let msgZ = { payload: datos[2] };                // Salida 4: Para Z\n    let msgYaw = { payload: datos[3] };              // Salida 5: Para Yaw\n    \n    // 3. Enviamos los mensajes por los 5 puertos\n    return [msgTextoCompleto, msgX, msgY, msgZ, msgYaw];\n}\n\n// Si llega un error o un texto incompleto, solo lo pasa por la salida 1\nreturn [msg, null, null, null, null];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 140,
        "wires": [
