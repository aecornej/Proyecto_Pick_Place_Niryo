    {
        "id": "383f033ffbd539ed",
        "type": "ui-template",
        "z": "74d43a4238c77af7",
        "group": "dcb4697eb5e1c243",
        "page": "",
        "ui": "",
        "name": "Alertas del Sistema",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <!-- 1. ALERTA: ZONA OCUPADA (Sensor IR en el Place) -->\n    <div class=\"alerta-roja\" v-if=\"msg?.payload && msg.payload.includes('ZONA OCUPADA')\">\n        <h3>⚠️ ALERTA: ZONA DE DESCARGA LLENA</h3>\n        <p>{{ msg.payload }}</p>\n    </div>\n    \n    <!-- 2. ALERTA: PARO DE EMERGENCIA -->\n    <div class=\"alerta-roja\" v-else-if=\"msg?.payload && msg.payload.includes('Emergencia')\">\n        <h3>🛑 PARO DE EMERGENCIA ACTIVADO</h3>\n        <p>{{ msg.payload }}</p>\n    </div>\n    \n    <!-- 3. CAJA VERDE: SISTEMA ACTIVO (Mensajes normales, en espera o vacío) -->\n    <div class=\"alerta-verde\" v-else>\n        <h3>✅ SISTEMA ACTIVO</h3>\n        <p>Operando normalmente. El robot está a la espera.</p>\n    </div>\n</template>\n\n<style>\n    /* Diseño y colores de las cajas */\n    .alerta-roja {\n        background-color: #8b0000; \n        color: white; \n        padding: 15px; \n        border-radius: 5px; \n        border-left: 8px solid red;\n    }\n    .alerta-verde {\n        background-color: #242424;\n        color: #4CAF50;\n        padding: 15px;\n        border-radius: 5px;\n        border-left: 8px solid #4CAF50;\n    }\n    h3 {\n        margin-top: 0;\n        margin-bottom: 5px;\n    }\n    p {\n        margin: 0;\n        font-size: 16px;\n    }\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 910,
        "y": 560,
        "wires": [
            []
        ]
    },
