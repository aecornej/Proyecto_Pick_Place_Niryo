        "format": "<template>\n    <div style=\"display: flex; justify-content: center; align-items: center; width: 100%; background: #000; border-radius: 6px; overflow: hidden;\">\n        <img \n            src=\"http://localhost:5000/video_feed\" \n            style=\"width: 100%; height: auto; max-height: 400px; object-fit: contain; display: block;\"\n            alt=\"Conectando cámara...\"\n        >\n    </div>\n</template>",
