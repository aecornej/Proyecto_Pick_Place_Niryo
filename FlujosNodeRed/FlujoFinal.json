    {
        "id": "502ab6c00a75f8fa",
        "type": "function",
        "z": "190df1280c0874f3",
        "name": "function 1",
        "func": "// 1. Python envía un texto con comas (ej. \"0.150,-0.200,0.180,1.500,-1.500,0.000\")\nlet datos = msg.payload.split(\",\");\n\n// Verificamos que lleguen exactamente los 6 datos esperados\nif (datos.length === 6) {\n    let msgTextoCompleto = { payload: msg.payload }; // Salida 1: Texto sin procesar\n    let msgX = { payload: datos[0] };                // Salida 2: X\n    let msgY = { payload: datos[1] };                // Salida 3: Y\n    let msgZ = { payload: datos[2] };                // Salida 4: Z\n    let msgRoll = { payload: datos[3] };             // Salida 5: Roll\n    let msgPitch = { payload: datos[4] };            // Salida 6: Pitch\n    let msgYaw = { payload: datos[5] };              // Salida 7: Yaw\n\n    // Enviamos los mensajes por los 7 puertos\n    return [msgTextoCompleto, msgX, msgY, msgZ, msgRoll, msgPitch, msgYaw];\n}\n\n// Si llega un error o un texto incompleto, no actualiza los relojes\nreturn [msg, null, null, null, null, null, null];",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 140,
        "wires": [
