    {
        "id": "1e0a42e00a182023",
        "type": "function",
        "z": "190df1280c0874f3",
        "name": "Formato y Filtro",
        "func": "let emergencia = context.get('emergencia') || false;\nlet texto = msg.payload;\n\n// 1. Si detecta Emergencia, activa el bloqueo y añade el ícono\nif (texto.includes(\"Paro de Emergencia\")) {\n    context.set('emergencia', true);\n    msg.payload = \"🚨 \" + texto;\n    return msg;\n}\n\n// 2. Si hay START, quita el bloqueo\nif (texto.includes(\"[START]\")) {\n    context.set('emergencia', false);\n    emergencia = false;\n}\n\n// 3. Si está bloqueado por emergencia, destruye los demás mensajes\nif (emergencia) {\n    return null; \n}\n\n// 4. Si es normal, deja pasar el texto tal cual\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
